# Local, offline configuration. No external services or API keys are used.
PORT=3001
NODE_ENV=development

# Seed for the synthetic dataset. Change it for a different (still reproducible) dataset.
FIXTURE_SEED=1337

# Simulated pipeline (runs inside the API). Set WORKER_ENABLED=false for a static dataset.
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=60

# Optional scoring / display tweaks
ALPHA_FRESH_WALLET_DAYS=7
SMART_MONEY_BUY_WINDOW_HOURS=72
